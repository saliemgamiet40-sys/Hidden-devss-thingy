ups.InputBegan:Connect(function(inp, proc)
	if proc then return end
	if inp.KeyCode == Enum.KeyCode.Four then
		if cooldowns[5] then return end

		local camera = workspace.CurrentCamera
		local rayOrigin = camera.CFrame.Position
		local rayDirection = (ms.Hit.p - rayOrigin).Unit * 8

		local raycastParams = RaycastParams.new()
		raycastParams.FilterDescendantsInstances = {char}
		raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

		local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)

		if result then
			remote5:FireServer(result and result.Instance or nil, animation.AnimationId)
		end
	end
end)

