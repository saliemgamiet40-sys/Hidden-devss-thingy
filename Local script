}

cooldownRemote5.OnClientEvent:Connect(function(timeLeft)
	local gui = plr.PlayerGui:WaitForChild("CoolDownGui").CoolDowns
	local cooldownLabel = gui.CoolDown5
	cooldownLabel.Visible = timeLeft > 0
	cooldownLabel.Text = "Cooldown: "..timeLeft.." {"..handler.MoveNames.Move5 .."}"
	cooldownLabel.Cooldown.Visible = false
	cooldowns[5] = timeLeft > 0
	print("Move5 cooldown:", timeLeft)
end)

