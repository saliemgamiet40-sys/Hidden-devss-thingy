local CooldownRemote2 = game.ReplicatedStorage.Remotes.CooldownRemotes:WaitForChild("Cooldown2")
local CooldownRemote3 = game.ReplicatedStorage.Remotes.CooldownRemotes:WaitForChild("Cooldown3")
local CooldownRemote4 = game.ReplicatedStorage.Remotes.CooldownRemotes:WaitForChild("Cooldown4")
local CooldownRemote5 = game.ReplicatedStorage.Remotes.CooldownRemotes:WaitForChild("Cooldown5")

local playerCooldowns = {}



local function isOnCooldown(plr, moveId)
	local now = os.clock()
	playerCooldowns[plr.UserId] = playerCooldowns[plr.UserId] or {}
	local moveCooldown = playerCooldowns[plr.UserId][moveId]

	return moveCooldown and moveCooldown > now
end

local function setCooldown(plr, moveId, duration, cooldownRemote)
	playerCooldowns[plr.UserId] = playerCooldowns[plr.UserId] or {}
	local expireTime = os.clock() + duration
	playerCooldowns[plr.UserId][moveId] = expireTime

	task.spawn(function()
		for i = duration, 0, -1 do
			cooldownRemote:FireClient(plr, i)
			task.wait(1)
		end
	end)
end

AbilityEvent5.OnServerEvent:Connect(function(plr, hitPart, animId)
	if not isOnCooldown(plr, 5) then
		MoveHandler4.Move5(plr, hitPart, animId)
		setCooldown(plr, 5, CoolDownHandler.MoveCooldowns.Move5, CooldownRemote5)
	end
end)

